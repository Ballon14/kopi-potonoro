# ====================================
# KOPIKU - Environment Variables Example
# ====================================
# Copy this file to .env.local and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/kopiku

# Clerk Authentication (if used)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# Midtrans Payment Gateway (if used)
# MIDTRANS_SERVER_KEY=your_server_key
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_client_key

# RajaOngkir API (if used)
# RAJAONGKIR_API_KEY=your_api_key

# ====================================
# PRODUCTION SETTINGS
# ====================================
# Upload directory for images (production only)
# Set this to an absolute path outside the project directory
# UPLOAD_DIR=/var/www/kopi-potorono/uploads

# Node environment
# NODE_ENV=production
